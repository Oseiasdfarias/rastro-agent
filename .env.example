# Modelos em ordem de preferência; o próximo é usado se o anterior falhar.
LLM_MODELS=ollama/qwen2.5:3b
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
MAX_STEPS=8
# Tracing: start with `docker compose --profile observability up -d`, then set true.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-rastro-local
LANGFUSE_SECRET_KEY=sk-lf-rastro-local
LANGFUSE_HOST=http://langfuse-web:3000
LLM_CACHE=true
